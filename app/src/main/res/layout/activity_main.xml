<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    android:background="@color/white">

    <!-- Результат игры -->
    <TextView
        android:id="@+id/textResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/result_text"
        android:textSize="20sp"
        android:layout_marginBottom="24dp"
        android:textColor="@color/black"/>

    <!-- Счёт -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/textPlayerScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player_score"
            android:textSize="18sp"
            android:layout_marginEnd="16dp"
            android:textColor="@color/black"/>

        <TextView
            android:id="@+id/textComputerScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/computer_score"
            android:textSize="18sp"
            android:textColor="@color/black"/>
    </LinearLayout>

    <!-- Кнопки выбора -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/buttonRock"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/rock"
            android:background="@color/white"
            android:contentDescription="@string/rock"
            android:layout_marginEnd="8dp"
            android:padding="4dp"
            android:scaleType="fitCenter" /> <!-- Добавлено -->

        <ImageButton
            android:id="@+id/buttonPaper"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/paper"
            android:background="@color/white"
            android:contentDescription="@string/paper"
            android:layout_marginEnd="8dp"
            android:padding="4dp"
            android:scaleType="fitCenter" /> <!-- Добавлено -->

        <ImageButton
            android:id="@+id/buttonScissors"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/scissors"
            android:background="@color/white"
            android:contentDescription="@string/scissors"
            android:padding="4dp"
            android:scaleType="fitCenter" /> <!-- Добавлено -->

    </LinearLayout>

    <!-- Настройки и повтор -->
    <Button
        android:id="@+id/buttonSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/purple_500"
        android:textColor="@color/white"/>

    <Button
        android:id="@+id/buttonPlayAgain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/play_again"
        android:visibility="gone"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/purple_500"
        android:textColor="@color/white"/>
</LinearLayout>
