<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Основная тема приложения -->
    <style name="Theme.Lab2" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Основные цвета -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Цвета статусбара и навигации -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/purple_700</item>
        <item name="android:navigationBarColor">@color/purple_700</item>

        <!-- Настройки Material3 кнопок -->
        <item name="materialButtonStyle">@style/Widget.Material3.Button</item>
    </style>

    <style name="Widget.Lab2.Button.FilledButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/purple_500</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.Lab2.Button.FilledTonalButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/teal_200</item>
        <item name="android:textColor">@color/black</item>
    </style>

</resources>
